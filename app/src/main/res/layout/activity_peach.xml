<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶部标题栏 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#008577"
        android:gravity="center"
        android:text="@string/peach_title"
        android:textColor="@android:color/white"
        android:textSize="20sp" />

    <!-- 场景：整张背景图铺满 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tree_bg">

        <!--
            树：固定 300dp x 289dp，宽高比和 tree.png(337x325) 一致，
            这样背景图不会被拉伸变形；桃子按这个“画布”的坐标摆放。
        -->
        <RelativeLayout
            android:layout_width="300dp"
            android:layout_height="289dp"
            android:layout_centerInParent="true"
            android:layout_marginTop="70dp"
            android:background="@drawable/tree">

            <!-- 第一排：1 个桃子 -->
            <ImageView
                android:id="@+id/btn_one"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="128dp"
                android:layout_marginTop="55dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/peach_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/peach_pic" />

            <!-- 第二排：2 个桃子 -->
            <ImageView
                android:id="@+id/btn_two"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="83dp"
                android:layout_marginTop="100dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/peach_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/peach_pic" />

            <ImageView
                android:id="@+id/btn_three"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="173dp"
                android:layout_marginTop="100dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/peach_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/peach_pic" />

            <!-- 第三排：3 个桃子 -->
            <ImageView
                android:id="@+id/btn_four"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="53dp"
                android:layout_marginTop="145dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/peach_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/peach_pic" />

            <ImageView
                android:id="@+id/btn_five"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="128dp"
                android:layout_marginTop="145dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/peach_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/peach_pic" />

            <ImageView
                android:id="@+id/btn_six"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="203dp"
                android:layout_marginTop="145dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/peach_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/peach_pic" />
        </RelativeLayout>

        <!-- 退出按钮：backgroundTint=@null，避免 Material 主题把背景图染色 -->
        <Button
            android:id="@+id/btn_exit"
            android:layout_width="100dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="50dp"
            android:background="@drawable/btn_peach"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/peach_exit"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            app:backgroundTint="@null" />
    </RelativeLayout>
</LinearLayout>
